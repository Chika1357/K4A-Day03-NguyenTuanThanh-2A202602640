# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Provider dùng khi nghiệm thu chính thức
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Lựa chọn thay thế: Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# Chạy kiểm thử offline, không dùng API
# LLM_PROVIDER=mock

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
